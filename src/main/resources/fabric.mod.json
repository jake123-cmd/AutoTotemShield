{
  "schemaVersion": 1,
  "id": "autototemshield",
  "version": "${version}",
  "name": "Auto Totem Shield",
  "description": "Automatically swaps between a shield and Totem based on configurable health settings.",
  "authors": ["Robert"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.robert.autototemshield.AutoTotemShieldClient"
    ],
    "modmenu": [
      "com.robert.autototemshield.AutoTotemShieldModMenu"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.1.2",
    "java": ">=25",
    "fabric-api": "*",
    "modmenu": ">=18.0.0-beta.1"
  }
}
